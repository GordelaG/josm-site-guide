rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Aeroportos e histórico de atualizações:
    // Leitura pública (para exibir o mapa e o changelog a qualquer visitante)
    // Escrita restrita a administradores autenticados via Clerk / backend
    match /airports/{airportId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
